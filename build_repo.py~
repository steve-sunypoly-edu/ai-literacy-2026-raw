    f.write('<a href="artifacts/ai-literacy-commercial-license.html" class="card" style="text-align:center; text-decoration:none;">🚀 AL</a></div></section>')
    f.write('<section class="card"><h2>🗣️ Transcripts</h2>')
    for m in generated_metadata:
