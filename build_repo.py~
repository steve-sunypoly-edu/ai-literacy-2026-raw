    html_template += "<footer><p>AIX Center · SUNY Polytechnic Institute</p></footer></body></html>"

    new_name = f"{i:02d}_{base_name.replace(' ', '_').replace(',', '').replace('-', '_').lower()}.html"
    with open(os.path.join(conversations_dir, new_name), 'w', encoding='utf-8') as f: f.write(html_template)
    generated_files.append((base_name, new_name))

