# REDACTION CONFIGURATION
# ==========================================
colleagues_to_redact = [
    "Dana Gavin", "Dana",
    "Michelle Malinovjky", "Michelle Malinovsky", "Michelle",
    "Diane Schictman", "Diane Schichtman", "Diane",
    "Shyam Sharma", "Shyam"
]

students_to_redact = [
    "Firstname Lastname", 
    "JustFirstname"
]

author_names = ["Steve Schneider", "Steve"]

def clean_email_artifacts(text):
    if not text: return text
    text = re.sub(r'(?si)From:\s+.*?Subject:\s+[^\n]*\n?', '[Email Header Redacted]\n', text)
    sig_pattern = r'(?si)Steven M\. Schneider\s*Professor, SUNY Polytechnic Institute.*?Book time to meet with me'
    text = re.sub(sig_pattern, '', text)
    return text

def redact_text(text):
    if not text: return text
    text = clean_email_artifacts(text)
    for name in sorted(colleagues_to_redact, key=len, reverse=True):
        text = re.sub(r'(?i)\b' + re.escape(name) + r'\b', '[Colleague]', text)
    for name in sorted(students_to_redact, key=len, reverse=True):
        if name != "Firstname Lastname" and name != "JustFirstname": 
            text = re.sub(r'(?i)\b' + re.escape(name) + r'\b', '[Student]', text)
    for name in sorted(author_names, key=len, reverse=True):
        text = re.sub(r'(?i)\b' + re.escape(name) + r'\b', '[The author]', text)
    return text

