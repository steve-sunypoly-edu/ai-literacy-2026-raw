def get_nav_html(depth=0, current_num=None, total=12, prev_f=None, next_f=None):
    prefix = "../" * depth
    hub = f"{prefix}index.html"
    lp = f"{prefix}artifacts/ai-literacy-learners-permit.html"
    al = f"{prefix}artifacts/ai-literacy-commercial-license.html"
    
    prev_attr = f'href="{prev_f}"' if prev_f else 'style="opacity:0.2; pointer-events:none;"'
    next_attr = f'href="{next_f}"' if next_f else 'style="opacity:0.2; pointer-events:none;"'
    
    seq_html = ""
    if current_num:
        seq_html = f'<div class="nav-group"><a {prev_attr} class="nav-link">⬅️</a> <span style="font-weight:900;">{current_num}/{total}</span> <a {next_attr} class="nav-link">➡️</a></div>'
    else:
        seq_html = f'<div class="nav-group"><span style="font-weight:900; color:var(--text-muted); font-size:0.8rem;">ARCHIVE v.{version_ts}</span></div>'

    return f'"""<nav class="sticky-nav"><div class="nav-container"><div class="nav-group"><a href="{hub}" class="nav-link">🏠 Hub</a> <a href="{lp}" class="nav-link">📜 LP</a> <a href="{al}" class="nav-link">🚀 AL</a></div>{seq_html}</div></nav>"""'

# ==========================================
# PROCESSING & OVERWRITING
# ==========================================
ordered_files = [
    "AI literacy development through iterative refinement", "AI-FYE document structure and course design",
    "AI integration across course levels", "AI literacy curriculum project invitation",
    "AI document edits and review", "The teacher, the student and the LLM", "Seeking feedback",
    "AI adoption in academic integrity and learning outcomes", "AI literacy progression framework",
    "Project memory update", "Project context report generation", "Processing podcast links with curriculum tagging"
]

zip_files = glob.glob("*.zip")
conversations = {}
for zp in zip_files:
    with zipfile.ZipFile(zp, 'r') as z:
        for filename in z.namelist():
            if filename.endswith('.json') and 'export_summary' not in filename:
                with z.open(filename) as f:
                    data = json.load(f)
                    if data.get("name"): conversations[data["name"]] = data

conversations_dir = "conversations"
os.makedirs(conversations_dir, exist_ok=True)
generated_metadata = []

for i, base_name in enumerate(ordered_files, 1):
    data = next((v for k, v in conversations.items() if base_name in k), None)
    if not data: continue
    raw_summary = redact_text(data.get("summary", "No overview available."))
    sentences = re.split(r'(?<=[.!?]) +', raw_summary.replace('\n', ' '))
    messages = data.get("chat_messages", data.get("messages", []))
    exchanges = []
    current_human = None
    for msg in messages:
        text = "".join(b.get("text", "") for b in msg.get("content", []) if b.get("type") == "text")
        if msg.get("sender") == "human": current_human = {"text": text}
        elif msg.get("sender") == "assistant" and current_human:
            exchanges.append({"human": current_human, "assistant": {"text": text}})
            current_human = None
    file_name = f"{i:02d}_{base_name.replace(' ', '_').lower()}.html"
    generated_metadata.append({"num": i, "title": base_name, "file": file_name, "second": sentences[1] if len(sentences)>1 else "", "full": markdown.markdown(raw_summary), "exchanges": exchanges})

# Build Transcript Pages
for idx, m in enumerate(generated_metadata):
    p_link = generated_metadata[idx-1]["file"] if idx > 0 else None
    n_link = generated_metadata[idx+1]["file"] if idx < len(generated_metadata)-1 else None
    nav_block = eval(get_nav_html(depth=1, current_num=m['num'], prev_f=p_link, next_f=n_link))
    
    with open(os.path.join(conversations_dir, m["file"]), 'w', encoding='utf-8') as f:
        f.write(f'<!DOCTYPE html><html lang="en"><head><style>{css_template}</style></head><body>{nav_block}')
        f.write(f"<h1>{m['num']}. {m['title']}</h1><div class='card'>{m['full']}</div>")
        for p_idx, ex in enumerate(m["exchanges"], 1):
            f.write(f"<div class='card' style='background:var(--prompt-bg)'><strong>Prompt {p_idx}</strong><br>{html.escape(redact_text(ex['human']['text']))}</div>")
            f.write(f"<div class='card'>{markdown.markdown(redact_text(ex['assistant']['text']), extensions=['fenced_code', 'tables'])}</div>")
        f.write("</body></html>")

# PATCHING MANUAL ARTIFACTS
artifacts_dir = "artifacts"
for art in ["ai-literacy-learners-permit.html", "ai-literacy-commercial-license.html"]:
    path = os.path.join(artifacts_dir, art)
    if os.path.exists(path):
        with open(path, 'r', encoding='utf-8') as f:
            content = f.read()
        
        # Clean existing style/nav if this is a re-run
        content = re.sub(r'<style>.*?</style>', '', content, flags=re.DOTALL)
        content = re.sub(r'<nav class="sticky-nav">.*?</nav>', '', content, flags=re.DOTALL)
        
        nav_block = eval(get_nav_html(depth=1))
        # Insert style in head, nav in body
        new_style = f'<style>{css_template}</style>'
        if '</head>' in content:
            content = content.replace('</head>', f'{new_style}</head>')
        else:
            content = new_style + content
            
        if '<body>' in content:
            content = content.replace('<body>', f'<body>{nav_block}')
        else:
            content = nav_block + content
            
        with open(path, 'w', encoding='utf-8') as f:
            f.write(content)

