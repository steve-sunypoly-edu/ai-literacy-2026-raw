    "AI literacy progression framework",
    "Project memory update",
    "Project context report generation",
    "Processing podcast links with curriculum tagging"
]

zip_files = glob.glob("*.zip")
conversations = {}

for zp in zip_files:
    try:
        with zipfile.ZipFile(zp, 'r') as z:
            for filename in z.namelist():
                if not filename.endswith('.json') or 'export_summary' in filename:
                    continue
                with z.open(filename) as f:
                    try:
                        data = json.load(f)
                        if data.get("name"): conversations[data["name"]] = data
                    except: pass
    except: pass

conversations_dir = "conversations"
os.makedirs(conversations_dir, exist_ok=True)
generated_files = []

for i, base_name in enumerate(ordered_files, 1):
    data = next((v for k, v in conversations.items() if base_name in k), None)
    if not data: continue

    title = data.get("name", "Conversation")
    summary_md = redact_text(data.get("summary", "No summary available."))
    summary_html = markdown.markdown(summary_md)

    messages = data.get("chat_messages", data.get("messages", []))
    if not messages and isinstance(data, list): messages = data

    exchanges = []
    current_human = None

    for msg in messages:
        text = "".join(b.get("text", "") for b in msg.get("content", []) if b.get("type") == "text")
        time_str = ""
        try:
            raw_time = msg.get("created_at", "")
            utc_dt = datetime.strptime(raw_time, "%Y-%m-%dT%H:%M:%S.%fZ").replace(tzinfo=timezone.utc)
            est_dt = utc_dt.astimezone(est_tz)
            time_str = est_dt.strftime("%I:%M %p EST")
        except: pass

        if msg.get("sender") == "human":
            current_human = {"text": text, "time": time_str}
        elif msg.get("sender") == "assistant" and current_human:
            exchanges.append({"human": current_human, "assistant": {"text": text, "time": time_str}})
            current_human = None

