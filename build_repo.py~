    for prompt_num, ex in enumerate(exchanges, 1):
        raw_prompt = ex["human"]["text"]
        if not raw_prompt.strip(): raw_prompt = "[Attachment or Voice Input]"
        redacted_prompt = html.escape(redact_text(raw_prompt))
        
        redacted_response_md = redact_text(ex["assistant"]["text"])
        assistant_html = markdown.markdown(redacted_response_md, extensions=['fenced_code', 'tables'])
        assistant_html = assistant_html.replace('<a href=', '<a target="_blank" href=')
        
        html_template += f"""
