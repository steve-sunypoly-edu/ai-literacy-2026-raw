# ==========================================
# CONFIGURATION
# ==========================================
colleagues_to_redact = ["Dana Gavin", "Dana", "Michelle Malinovsky", "Michelle", "Diane Schichtman", "Diane", "Shyam Sharma", "Shyam"]
author_names = ["Steve Schneider", "Steve"]
version_ts = "2026-04-26-2158"

def redact_text(text):
    if not text: return text
    text = re.sub(r'(?si)From:\s+.*?Subject:\s+[^
]*
?', '[Email Header Redacted]\n', text)
    sig_pattern = r'(?si)Steven M\. Schneider\s*Professor, SUNY Polytechnic Institute.*?Book time to meet with me'
    text = re.sub(sig_pattern, '', text)
    for name in sorted(colleagues_to_redact + author_names, key=len, reverse=True):
        label = "[Colleague]" if name in colleagues_to_redact else "[The author]"
        text = re.sub(r'(?i)\b' + re.escape(name) + r'\b', label, text)
    return text

